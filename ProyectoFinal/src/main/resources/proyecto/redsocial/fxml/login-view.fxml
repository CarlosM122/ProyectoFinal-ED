<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.redsocial.controller.LoginView">
   <children>
      <Label layoutX="48.0" layoutY="126.0" prefHeight="42.0" prefWidth="88.0" text="Usuario:">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Label layoutX="48.0" layoutY="179.0" prefHeight="62.0" prefWidth="122.0" text="Contraseña:">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Button fx:id="btnIngreso" layoutX="178.0" layoutY="250.0" mnemonicParsing="false" onAction="#onIngresar" text="Ingresar" />
      <Button fx:id="btnRegistro" layoutX="343.0" layoutY="250.0" mnemonicParsing="false" onAction="#onRegistrar" text="Registrar" />
      <TextField fx:id="txtUsuario" layoutX="225.0" layoutY="134.0" />
      <PasswordField fx:id="txtContrasenia" layoutX="225.0" layoutY="197.0" />
   </children>
</AnchorPane>
