<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.redsocial.controller.SolicitudAyudaController">
    <children>
        <Label layoutX="60.0" layoutY="50.0" text="Tema de ayuda:">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
        <ComboBox fx:id="cbTemasAyuda" layoutX="249.0" layoutY="50.0" prefHeight="26.0" prefWidth="197.0" promptText="Selecciona una opcion" />

        <Button fx:id="btnEnviarSolicitud" layoutX="200.0" layoutY="251.0" onAction="#onEnviarSolicitud" text="Enviar Solicitud" />
      <TextArea fx:id="txtDescripcion" layoutX="56.0" layoutY="136.0" prefHeight="97.0" prefWidth="388.0" />
      <Label layoutX="56.0" layoutY="110.0" text="Descripcion:">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
