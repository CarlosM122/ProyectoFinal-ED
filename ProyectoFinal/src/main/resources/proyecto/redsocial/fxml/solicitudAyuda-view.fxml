<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/estiloMainPage.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.redsocial.controller.SolicitudAyudaController">

    <!-- Panel izquierdo -->
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="455.0" prefWidth="199.0" spacing="10" styleClass="side-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="10" right="10" top="20" />
            </padding>
              <VBox fx:id="VboxInicio" alignment="CENTER" onMousePressed="#onInicio" prefHeight="102.0" prefWidth="100.0" styleClass="nav-button">
                  <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                      <image>
                          <Image url="@../images/casa.png" />
                      </image>
                  </ImageView>
                  <Label styleClass="nav-label" text="Inicio" />
              </VBox>
         <VBox fx:id="contenedorImagenPerfil" alignment="BOTTOM_CENTER" prefHeight="510.0" prefWidth="158.0">
            <children>
                     <ImageView fitHeight="82.0" fitWidth="75.0" preserveRatio="true">
                         <image>
                             <Image url="@../images/usuario.png" />
                         </image>
                     </ImageView>
            </children>
         </VBox>
         <VBox alignment="CENTER" prefHeight="118.0" prefWidth="158.0">
            <children>
                     <Label fx:id="txtNombre" styleClass="profile-name" text="Nombre" />
                     <Label fx:id="txtInformacion" styleClass="profile-info" text="informacion" />
            </children>
         </VBox>
        </VBox>
    </left>

    <!-- Contenido principal -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area" BorderPane.alignment="CENTER">
            <content>
                <VBox alignment="TOP_CENTER" prefHeight="742.0" prefWidth="1040.0" spacing="15">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <HBox alignment="CENTER" prefHeight="70.0" prefWidth="713.0">
                        <children>
                            <AnchorPane prefHeight="83.0" prefWidth="125.0">
                        <children>
                           <Label layoutX="49.0" layoutY="25.0" text="Crear solicitud:  " />
                        </children>
                            </AnchorPane>
                     <ComboBox fx:id="CBTemas" prefHeight="27.0" prefWidth="308.0" promptText="Selecciona" styleClass="barra-busqueda">
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor></ComboBox>
                        </children>
                    </HBox>
               <TextArea fx:id="txtDescripcion" prefHeight="113.0" prefWidth="749.0" promptText="Descripcion del problema" />
               <Button fx:id="btnGenerarSolicitud" mnemonicParsing="false" onAction="#OnbtnGenerarSolicitud" styleClass="barra-busqueda" text="Generar Solicitud">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor></Button>
                    <Label alignment="CENTER" prefHeight="32.0" prefWidth="749.0" styleClass="publicaciones-label" text="Solicitudes" textFill="#686363" />
                    <VBox fx:id="contenedorSolicitudes" prefHeight="376.0" prefWidth="749.0" />
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
