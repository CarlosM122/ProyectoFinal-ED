                              </ImageView>
                              <Label alignment="CENTER" prefHeight="19.0" prefWidth="82.0" text="Mensajes" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="95.0">
                           <children>
                              <ImageView fitHeight="40.0" fitWidth="61.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/ayudar.png" />
                                 </image>
                              </ImageView>
                              <Label alignment="CENTER" prefHeight="19.0" prefWidth="82.0" text="Ayuda" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                        <HBox alignment="CENTER" prefHeight="87.0" prefWidth="1260.0">
                            <children>
                                <Label prefHeight="23.0" prefWidth="161.0" text="Tema de ayuda:">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="cbTemasAyuda" prefHeight="26.0" prefWidth="197.0" promptText="Selecciona una opcion" />
