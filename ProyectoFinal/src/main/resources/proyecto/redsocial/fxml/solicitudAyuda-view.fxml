                        </VBox>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="95.0">
                           <children>
                              <ImageView fitHeight="40.0" fitWidth="61.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/conversacion.png" />
