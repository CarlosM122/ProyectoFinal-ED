                              </ImageView>
                              <Label alignment="CENTER" prefHeight="17.0" prefWidth="42.0" text="Inicio" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="95.0">
