<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;" stylesheets="@../css/estiloMainPage.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.redsocial.controller.GestionarSolicitudesController">
    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="publicaciones-label" text="Solicitudes Pendientes" />
    <TableView fx:id="tablaSolicitudes" prefWidth="600">
        <columns>
            <TableColumn fx:id="colEstudiante" prefWidth="150" text="Estudiante" />
            <TableColumn fx:id="colDescripcion" prefWidth="250" text="Descripción" />
            <TableColumn fx:id="colUrgencia" prefWidth="100" text="Urgencia" />
            <TableColumn fx:id="colAccion" prefWidth="100" text="Acción" />
        </columns>
    </TableView>
    <Button onAction="#onCerrar" styleClass="boton-acciones" text="Cerrar">
      <graphic>
         <ImageView fitHeight="77.0" fitWidth="29.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../images/images-removebg-preview.png" />
            </image>
         </ImageView>
      </graphic></Button>
</VBox>
